# DetourLoop — environment variables
# Copy to apps/mobile/.env and apps/web/.env.local (only the lines each app needs).
# Everything is optional: with nothing set, the mobile app runs in clearly labelled DEMO MODE
# (data on the device only, AI off, no share links, no purchases).

# ─── Mobile app (apps/mobile/.env) — PUBLIC values only, they are bundled into the app ───
EXPO_PUBLIC_SUPABASE_URL=            # https://<project>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=       # anon / publishable key (RLS protects the data)
EXPO_PUBLIC_MAPBOX_TOKEN=            # optional public token (pk.*). Without it: OpenFreeMap tiles + OSRM routing + Photon search
EXPO_PUBLIC_WEB_URL=                 # deployed web app, e.g. https://detour.app — share links are <WEB_URL>/r/<token>
EXPO_PUBLIC_REVENUECAT_IOS_KEY=      # optional, public SDK key (appl_*)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=  # optional, public SDK key (goog_*)

# ─── Web app (apps/web/.env.local) ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=                 # where "Open the app" links go (e.g. the Expo web build or store page)
SUPABASE_SERVICE_ROLE_KEY=           # SERVER ONLY — signs media URLs for shared stories, Stripe webhook
STRIPE_SECRET_KEY=                   # SERVER ONLY — sk_live_/sk_test_
STRIPE_WEBHOOK_SECRET=               # SERVER ONLY — whsec_
STRIPE_PRICE_PLUS_MONTHLY=           # price_… for $2.25 / month
STRIPE_PRICE_PLUS_ANNUAL=            # price_… for $24 / year

# ─── Supabase Edge Function secrets (supabase secrets set …) — never in any app ───
OPENAI_API_KEY=                      # used only by supabase/functions/ai
OPENAI_MODEL=gpt-4.1-mini            # any model that supports json_schema structured outputs
RENDER_WORKER_URL=                   # optional: video render worker endpoint (FFmpeg)
RENDER_WORKER_SECRET=                # optional: shared secret for the worker
